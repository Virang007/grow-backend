import 'package:http/http.dart' as http;
import 'package:otp/otp.dart';

class GrowwAuth {
  // Groww Cloud → Generate TOTP token
  static const String growwTotpToken = '######';
  // Groww Cloud → TOTP Secret
  static const String growwTotpSecret = '#####';

  static Future<String?> generateAccessToken() async {
    try {
      // Generate current 6-digit TOTP
      final totp = OTP.generateTOTPCodeString(
        growwTotpSecret,
        DateTime.now().millisecondsSinceEpoch,
        length: 6,
        interval: 30,
        algorithm: Algorithm.SHA1,
        isGoogle: true,
      );

      print('TOTP: $totp');

      // Groww token API
      final response = await http.post(
        Uri.parse('https://api.groww.in/v1/token/api/access'),
        headers: {
          'Authorization': 'Bearer $growwTotpToken',
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: jsonEncode({
          'key_type': 'totp',
          'totp': totp,
        }),
      );

      print('Status: ${response.statusCode}');
      print('Response: ${response.body}');

      if (response.statusCode >= 200 && response.statusCode < 300) {
        final data = jsonDecode(response.body);

        final accessToken = data['token'];

        print('');
        print('==============================');
        print('GROWW ACCESS TOKEN:');
        print(accessToken);
        print('==============================');

        return accessToken;
      }

      print('Groww token generation failed');
      return null;
    } catch (e) {
      print('Error: $e');
      return null;
    }
  }
}